{
  "manifest_version": 3,
  "name": "Clipboard Pro",
  "version": "1.0.0",
  "description": "Access your Clipboard Pro history from the browser",
  "permissions": ["clipboardWrite", "storage"],
  "host_permissions": ["http://127.0.0.1:27843/*", "http://localhost:27843/*"],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'unsafe-inline'; frame-src http://127.0.0.1:27843 http://localhost:27843; object-src 'none'"
  }
}
